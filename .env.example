# Copy to .env (never commit .env). The scanner reads it from this folder or up to four folders above.
# Nothing here is required: without a key the questions come from templates, without SEARXNG_URL the search checks are skipped.

# Gemini writes the questions and the explanations. A second key is used if the first one fails (quota, outage).
GEMINI_API_KEY=
#GEMINI_API_KEY2=
# AGENTGUARD_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite   # tried in this order, each with every key (the free tier counts quota per model)

# An optional BACKUP language model, asked only when no Gemini model answers (any OpenAI-compatible API). What it writes is labelled
# as coming from a backup model, never as Gemini's. Excerpts of the page or profile are sent to it, so use a provider you trust.
#AI_API_KEY=
#AI_BASE_URL=https://api.example.com
#AI_MODEL=
# Extra request settings for that provider, as one JSON object. For a provider whose model "thinks" for a minute before answering,
# switching that off is the difference between 10 seconds and 60: check its documentation for the name of the setting.
#AI_EXTRA_JSON=

# A SearXNG server for the optional search checks, for example the one in searxng/docker-compose.yml
# (`docker compose --env-file .env -f searxng/docker-compose.yml up -d`). SEARXNG_SECRET is only read by that compose file:
# any long random value, for example `openssl rand -hex 32`.
#SEARXNG_URL=http://127.0.0.1:8888
#SEARXNG_SECRET=

# Raises GitHub's rate limit for repository scans. Public repositories only.
#GITHUB_TOKEN=

# Limits (the defaults are shown)
#AGENTGUARD_RATE_PER_HOUR=6        # runs per client address per hour
#AGENTGUARD_HOST_RATE_PER_HOUR=3   # runs per website per hour, whoever asks
#AGENTGUARD_DAILY_LLM_CALLS=200
#AGENTGUARD_KILL_SWITCH=1          # turns the model off at once
